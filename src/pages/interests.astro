---
import MainLayout from '../layouts/MainLayout.astro'
---

<MainLayout title="Interests">
  <div class="stub-page">
    <h1 class="stub-heading">Interests</h1>
    <p class="stub-text">Full interests section coming in Phase 5.</p>
  </div>
</MainLayout>

<style>
  .stub-page {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    padding: 2rem;
    text-align: center;
    gap: 1rem;
  }

  .stub-heading {
    font-family: var(--font-display);
    font-size: clamp(2rem, 6vw, 5rem);
    font-weight: 900;
    color: var(--color-primary);
    margin: 0;
  }

  .stub-text {
    font-family: var(--font-body);
    color: var(--color-text-muted);
    font-size: 1rem;
    margin: 0;
  }
</style>
